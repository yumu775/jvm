# 主要可执行文件
jvm.exe
jvm
jvm-*

# Go 编译产物
*.exe
*.exe~
*.dll
*.so
*.dylib

# 测试二进制文件
*.test

# 输出的二进制文件 (可选)
main

# ===========================================
# 开发和调试文件
# ===========================================

# 调试文件
debug
debug-*
*.debug
*.pdb

# 临时文件
*.tmp
*.temp
*~
.#*
\#*#

# 编辑器和IDE文件
.vscode/
.idea/
*.swp
*.swo
*~

# ===========================================
